# Bio-PDF Workbench backend configuration template (K01)
#
# Copy this file to ".env.local" (NEVER commit that file — it is ignored)
# and fill in the values you need. The CLI/worker takes it via
# --env-file; both the API process AND any supervised child
# (comparison side, queue worker subprocess, docling inference child)
# inherit the resolved values because the loader writes them into
# os.environ before any of them start.
#
# Priority rules — read these first, they are part of the contract:
#   1. Process environment wins over this file.
#   2. Unknown keys (typos) are rejected at load time — no silent ignore.
#   3. Duplicate keys in this file are rejected — one value per key.
#   4. Blank/whitespace-only values are treated as "not configured".
#
# The configured payload returned by /api/v1/capabilities reports the
# configured/missing state of every variable but never echoes a token.

# ---- MinerU cloud adapter -------------------------------------------------
# Personal token from https://mineru.net/apiManage
# Leaving this blank means the MinerU side of every comparison will fail with
# ENGINE_NOT_CONFIGURED — the comparison page disables creation/retry buttons
# in that state and reports the reason honestly.
MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm

# ---- Comparison runtime ---------------------------------------------------
# "process" (default, supervised child — production-safe budget termination)
# or "thread" (in-process; used by stub-based tests).
BIO_PDF_COMPARISON_RUN_MODE=process

# ---- API plumbing ---------------------------------------------------------
BIO_PDF_DATA_DIR=data/demo
BIO_PDF_SAMPLES_DIR=pdf/samples
# BIO_PDF_WEB_DIST=web/dist
# BIO_PDF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BIO_PDF_MAX_UPLOAD_BYTES=104857600
BIO_PDF_COMPARISON_SWEEP_SECONDS=15
