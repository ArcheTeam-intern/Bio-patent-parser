{
  "$defs": {
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "A location reference for an extracted value or statement.\n\nThe ``bbox`` field is optional because some upstream sources (e.g. an\nOCR-only PDF, or a continuation cell without its own coordinates) only\nknow the page. The contract distinguishes ``bbox is None`` from\n``bbox is not None but page is None``.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "description": "Axis-aligned box in PDF user space (points). Origin is bottom-left; x0 <= x1, y0 <= y1.",
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "raw_text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text"
        }
      },
      "required": [
        "evidence_id",
        "document_id"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A collection of :class:`EvidenceSpan` records.\n\nCentralises the per-document evidence index so domain rules and\nvalidators can pull all spans for a job without re-reading artifact\nfiles.",
  "properties": {
    "spans": {
      "items": {
        "$ref": "#/$defs/EvidenceSpan"
      },
      "title": "Spans",
      "type": "array"
    }
  },
  "title": "EvidenceBundle",
  "type": "object"
}